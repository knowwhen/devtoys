<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.devtoys</groupId>
  <artifactId>devtoys-parent</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>DevToys</name>
  <description>A Java port of DevToys, built with JavaFX + AtlantaFX.</description>
  <modules>
    <module>devtoys-api</module>
    <module>devtoys-core</module>
    <module>devtoys-tools</module>
    <module>devtoys-app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <javafx.version>21.0.5</javafx.version>
    <atlantafx.version>2.0.1</atlantafx.version>
<!--    <jackson.version>2.17.2</jackson.version>-->
    <junit.version>5.10.2</junit.version>

    <slf4j.version>2.0.13</slf4j.version>
    <logback.version>1.5.6</logback.version>
    <ikonli.version>12.3.1</ikonli.version>
  </properties>

  <dependencyManagement>
    <!--  JavaFX    -->
    <dependencies>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-base</artifactId>
        <version>${javafx.version}</version>
      </dependency>

      <!-- AtlantaFX theme -->
      <dependency>
        <groupId>io.github.mkpaz</groupId>
        <artifactId>atlantafx-base</artifactId>
        <version>${atlantafx.version}</version>
      </dependency>

      <!-- Logging: SLF4J API + Logback impl -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>

      <!-- Icons: Ikonli core + JavaFX integration + three icon packs -->
      <dependency>
        <groupId>org.kordamp.ikonli</groupId>
        <artifactId>ikonli-core</artifactId>
        <version>${ikonli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.kordamp.ikonli</groupId>
        <artifactId>ikonli-javafx</artifactId>
        <version>${ikonli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.kordamp.ikonli</groupId>
        <artifactId>ikonli-fluentui-pack</artifactId>
        <version>${ikonli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.kordamp.ikonli</groupId>
        <artifactId>ikonli-fontawesome5-pack</artifactId>
        <version>${ikonli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.kordamp.ikonli</groupId>
        <artifactId>ikonli-material2-pack</artifactId>
        <version>${ikonli.version}</version>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>io.devtoys</groupId>
        <artifactId>devtoys-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.devtoys</groupId>
        <artifactId>devtoys-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.devtoys</groupId>
        <artifactId>devtoys-tools</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--  Testing    -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

 <build>
   <pluginManagement>
     <plugins>
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-compiler-plugin</artifactId>
         <version>3.13.0</version>
         <configuration>
           <release>21</release>
         </configuration>
       </plugin>
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-surefire-plugin</artifactId>
         <version>3.2.5</version>
       </plugin>
       <plugin>
         <groupId>org.openjfx</groupId>
         <artifactId>javafx-maven-plugin</artifactId>
         <version>0.0.8</version>
       </plugin>
     </plugins>
   </pluginManagement>
 </build>
</project>
